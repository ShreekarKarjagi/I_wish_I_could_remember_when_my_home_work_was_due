# Copy this file to .env and fill it in. Never commit .env.

# Gradescope login (see README if your account is Berkeley-SSO only)
GRADESCOPE_EMAIL=you@berkeley.edu
GRADESCOPE_PASSWORD=

# bCourses personal access token (Account > Settings > New Access Token)
CANVAS_BASE_URL=https://bcourses.berkeley.edu
CANVAS_TOKEN=

# Where reminders go: google_tasks (default, nothing else to set below) or notion
REMINDER_DESTINATION=google_tasks

# Only needed if REMINDER_DESTINATION=notion -- see README for setup steps
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Only create reminders for assignments due within this many days
LOOKAHEAD_DAYS=21

# Date the reminder this many days before the due date (0 = on the due date)
REMIND_DAYS_BEFORE=0
